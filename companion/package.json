{
  "name": "@syncandrun/companion",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm ui:typecheck && pnpm ui:build && tsc --project tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && pnpm ui:typecheck",
    "ui:build": "vite build --config vite.config.ts",
    "ui:typecheck": "tsc --noEmit --project ui/tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0",
    "fastify": "5.12.1",
    "pino": "9.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "3.2.7"
  }
}
