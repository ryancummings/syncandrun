# Generate your private .env with scripts/setup-deployment.py. Never commit it.
COMPOSE_PROJECT_NAME=syncandrun
# Local build tag; use a distinct immutable tag for each upgrade.
SYNCANDRUN_IMAGE=syncandrun-companion:local
SYNCANDRUN_BASE_URL=https://music.example.com
SYNCANDRUN_ARTWORK_BASE_URL=
SYNCANDRUN_SECRET=
SYNCANDRUN_PORT=3000
SYNCANDRUN_BIND_ADDRESS=127.0.0.1
SYNCANDRUN_LOG_LEVEL=info
# true, false, or the proxy addresses whose X-Forwarded-For is believed
# (comma-separated IPs, CIDR ranges, or loopback/linklocal/uniquelocal).
# Use true only when nothing can reach the listener except the proxy.
SYNCANDRUN_TRUST_PROXY=false
SYNCANDRUN_ARTWORK_GATEWAY_PORT=3016
SYNCANDRUN_CLOUDFLARED_TOKEN_FILE=./cloudflared-token
SYNCANDRUN_HOST_SECRET_GID=1000
